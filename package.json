{
  "name": "kassa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Система учёта остатков и продаж (офлайн-first)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "setup": "tsx --env-file-if-exists=.env src/cli/setup.ts",
    "create-admin": "tsx --env-file-if-exists=.env src/cli/create-admin.ts",
    "reset-admin-password": "tsx --env-file-if-exists=.env src/cli/reset-admin-password.ts",
    "start": "tsx --env-file-if-exists=.env src/web/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@napi-rs/canvas": "1.1.1",
    "better-sqlite3": "13.1.1",
    "iconv-lite": "0.6.3",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
