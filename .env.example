# Путь к рабочей базе. Тесты этот файл не используют (у них своя временная база).
DB_PATH=./data/kassa.db
# Код точки продажи: префикс номера чека (A-000123)
BRANCH_CODE=A
BRANCH_NAME=Основная точка
# Сервер доступен только из локальной сети. Firewall должен разрешать порт только для LAN.
HOST=0.0.0.0
PORT=3000
# Linux CUPS queue configured for raw ESC/POS. Leave empty to keep print jobs queued without printing.
PRINTER_NAME=
# raster preserves RU/UZ glyphs; text uses CP866 and falls back to raster for unsupported glyphs.
PRINTER_MODE=raster
# Optional font file for raster printing (DejaVu Sans is used when available).
# PRINTER_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# Used only when no active administrator exists. Set a PASS of at least 5 characters before enabling.
ADMIN=admin
PASS=
DEFADMINLOGIN=false
