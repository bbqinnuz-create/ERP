# Путь к рабочей базе. Тесты этот файл не используют (у них своя временная база).
DB_PATH=./data/kassa.db
# Код точки продажи: префикс номера чека (A-000123)
BRANCH_CODE=A
BRANCH_NAME=Основная точка
# Сервер доступен только из локальной сети. Windows Firewall должен разрешать порт только для LAN.
HOST=0.0.0.0
PORT=3000
# Used only when no active administrator exists. Set a PASS of at least 5 characters before enabling.
ADMIN=admin
PASS=
DEFADMINLOGIN=false
